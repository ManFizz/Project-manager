@model MegaProject.Web.ViewModels.ProjectTaskViewModel
@using TaskStatus = MegaProject.Domain.Models.Enums.TaskStatus
@{
    ViewData["Title"] = "Edit Task";
}

<div class="container mt-5">
    <h2>Edit Task</h2>

    <form asp-action="Edit" asp-route-id="@ViewBag.ProjectTaskId" method="post">
        @Html.AntiForgeryToken()

        <input asp-for="ProjectId" type="hidden" />
        <input asp-for="AuthorId" type="hidden" />

        <div class="mb-3">
            <label asp-for="Name" class="form-label">Name</label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Comment" class="form-label">Comment</label>
            <textarea asp-for="Comment" class="form-control" rows="3"></textarea>
        </div>

        <div class="mb-3">
            <label asp-for="Priority" class="form-label">Priority</label>
            <input asp-for="Priority" type="number" class="form-control" min="0" />
        </div>

        <div class="mb-3">
            <label asp-for="Status" class="form-label">Status</label>
            <select asp-for="Status" asp-items="Html.GetEnumSelectList<TaskStatus>()" class="form-select"></select>
        </div>

        <div class="mb-3">
            <label asp-for="WorkerId" class="form-label">Worker <span class="text-muted">(optional)</span></label>
            <select asp-for="WorkerId" class="form-select">
                <option value="">-- Not assigned --</option>
                @foreach (var emp in Model.Employees)
                {
                    <option value="@emp.Id" selected="@(Model.WorkerId == emp.Id)">
                        @emp.LastName @emp.FirstName
                    </option>
                }
            </select>
        </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-action="Index" asp-route-projectId="@Model.ProjectId" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>
